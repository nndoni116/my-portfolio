---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';

type Work = CollectionEntry<'works'>;

export async function getStaticPaths() {
  const works = await getCollection('works');

  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props as { work: Work };
const { title, description, thumbnail, techStack, projectUrl, details = '', impressions = '' } = work.data;
const detailsText = details || 'このプロジェクトでは、ユーザー視点を意識したデザインと操作性を重視し、実際のサイト制作に近い形で構築しました。';
const impressionsText = impressions || '実装を通じてUI設計やレスポンシブ対応の理解が深まり、今後もさらに成長していきたいと強く感じました。';
---

<BaseLayout title={`${title} | Portfolio`}>
  <Header />

  <main class="bg-brand-light min-h-screen">
    <article class="max-w-6xl mx-auto px-6 pt-32 pb-24 md:px-12 md:pt-40 md:pb-32">
      <a
        href="/#works"
        class="inline-flex items-center gap-2 text-xs font-sans tracking-[0.2em] uppercase opacity-60 hover:opacity-100 transition-opacity mb-10"
      >
        <span aria-hidden="true">&larr;</span>
        Works
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-start">
        <div class="overflow-hidden border border-brand-dark/10 bg-white/40">
          <img
            src={thumbnail}
            alt={title}
            class="w-full aspect-video object-cover"
          />
        </div>

        <div>
          <span class="text-xs font-sans tracking-[0.3em] uppercase opacity-50 block mb-4">Project Detail</span>
          <h1 class="text-3xl md:text-5xl font-serif font-light tracking-wide leading-tight mb-8">{title}</h1>

          <p class="whitespace-pre-line text-base font-sans font-light opacity-80 leading-loose mb-10">{description}</p>

          <div class="mb-10">
            <h2 class="text-xs font-sans tracking-[0.25em] uppercase opacity-50 mb-4">主な使用技術</h2>
            <div class="flex flex-wrap gap-2">
              {techStack.map((tech) => (
                <span class="text-xs font-sans tracking-wider border border-brand-dark/20 px-3 py-2 opacity-70">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <a
            href={projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 border border-brand-dark px-6 py-4 text-xs font-sans tracking-[0.2em] uppercase hover:bg-brand-dark hover:text-brand-light transition-colors"
          >
            Visit Site
            <span aria-hidden="true">&rarr;</span>
          </a>
          </div>
        </div>
      </div>
      <div class="mt-12 space-y-30">
            <div>
              <h2 class="text-lg font-bold tracking-[0.25em] uppercase opacity-80 mb-4">＜サイト詳細＞</h2>
              <p class="whitespace-pre-line text-base font-sans font-light opacity-80 leading-loose">
                {detailsText}
              </p>
            </div>

            <div>
              <h2 class="text-lg font-bold tracking-[0.25em] uppercase opacity-80 mb-4">＜制作の感想＞</h2>
              <p class="whitespace-pre-line text-base font-sans font-light opacity-80 leading-loose">
                {impressionsText}
              </p>
            </div>
          </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

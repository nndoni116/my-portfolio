    <img src="/images/header-logo.png" alt="Logo" class="h-10 w-auto">
    <span class="font-bold tracking-widest text-sm md:text-lg  text-brand-dark">PORTFOLIO</span>
  </a>
  <nav class="flex gap-8 text-sm font-bold tracking-[0.2em] uppercase text-brand-dark">
    <a href="/#works" class="hover:text-brand-accent transition-colors">Works</a>
    <a href="/#about" class="hover:text-brand-accent transition-colors">About</a>
    <a href="/#outro" class="hover:text-brand-accent transition-colors">Outro</a>

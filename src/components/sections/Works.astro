---
// src/components/sections/Works.astro
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';

const allWorks = await getCollection('works');
const sortedWorks = allWorks.sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<div class="max-w-6xl mx-auto px-6 py-24 md:px-12 md:py-32">
  <div class="mb-16 md:mb-24">
    <span class="text-xs font-sans tracking-[0.3em] uppercase opacity-50 block mb-3">01 / Projects</span>
    <h2 class="text-3xl md:text-5xl font-serif font-light tracking-wide">Selected Works</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
    {sortedWorks.map((work) => (
      <ProjectCard 
        title={work.data.title}
        description={work.data.description}
        thumbnail={work.data.thumbnail}
        techStack={work.data.techStack}
        linkUrl={work.data.linkUrl}
      />
    ))}
  </div>
</div>
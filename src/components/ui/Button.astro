---
// src/components/ui/Button.astro
interface Props {
  href: string;
  className?: string;
}
const { href, className = "" } = Astro.props;
---

<a 
  href={href} 
  class={`inline-block border border-brand-dark px-8 py-3 font-sans text-xs tracking-[0.2em] uppercase transition-all duration-300 hover:bg-brand-dark hover:text-brand-light ${className}`}
>
  <slot />
</a>
---
// src/components/ui/ProjectCard.astro
interface Props {
  title: string;
  description: string;
  thumbnail: string;
  techStack: string[];
  linkUrl: string; // ★プロップス（データ）を追加
}

const { title, description, thumbnail, techStack, linkUrl } = Astro.props;
---

<a 
  href={linkUrl} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="group relative flex flex-col justify-between overflow-hidden border border-brand-dark/10 p-6 bg-white/40 backdrop-blur-sm hover:border-brand-accent transition-all duration-500 block cursor-pointer"
>
  <div>
    <div class="overflow-hidden mb-6 aspect-video">
      <img 
        src={thumbnail} 
        alt={title} 
        class="w-full h-full object-cover scale-100  transition-all duration-700 ease-out"
      />
    </div>
    <h3 class="text-2xl font-serif font-light tracking-wide mb-3 flex justify-between items-center">
      {title}
      <span class="text-xl transform translate-x-0 group-hover:translate-x-1 transition-transform duration-300 text-brand-accent">&rarr;</span>
    </h3>
    <p class="whitespace-pre-line text-sm font-sans font-light opacity-80 leading-relaxed mb-6">{description}</p>
  </div>
  
  <div class="flex flex-wrap gap-2">
    {techStack.map((tech) => (
      <span class="text-xs font-sans tracking-wider border border-brand-dark/20 px-2 py-1 opacity-60">
        {tech}
      </span>
    ))}
  </div>
</a>
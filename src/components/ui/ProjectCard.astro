---
// src/components/ui/ProjectCard.astro
interface Props {
  title: string;
  description: string;
  thumbnail: string;
  techStack: string[];
  detailsUrl: string;
}

const { title, description, thumbnail, techStack, detailsUrl } = Astro.props;
---

<a
  href={detailsUrl}
  class="group relative flex flex-col justify-between overflow-hidden rounded-[1.5rem] border border-brand-dark/10 bg-white/80 p-6 shadow-sm shadow-brand-dark/5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-accent hover:bg-white hover:shadow-[0_30px_60px_-20px_rgba(157,110,47,0.45)] block cursor-pointer"
>
  <div>
    <div class="overflow-hidden mb-6 aspect-video rounded-3xl">
      <img
        src={thumbnail}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      />
    </div>
    <h3
      class="text-2xl font-serif font-semibold tracking-wide mb-3 flex justify-between items-start gap-4"
    >
      <span>{title}</span>

    </h3>
    <p
      class="whitespace-pre-line text-sm font-sans font-light opacity-80 leading-relaxed mb-6"
    >
      {description}
    </p>
  </div>
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-4">
      <span class="text-xs font-sans tracking-[0.3em] uppercase text-brand-dark opacity-60">Tap to open</span>
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-dark px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-brand-dark transition-all duration-300 group-hover:bg-brand-accent group-hover:text-brand-light group-hover:border-transparent">
        View details
        <span aria-hidden="true">&rarr;</span>
      </span>
    </div>
    <p class="text-base font-serif opacity-70">主要な使用技術：</p>
    <div class="flex flex-wrap gap-2">
      {
        techStack.map((tech) => (
          <span class="text-xs font-sans tracking-wider border border-brand-dark/20 px-2 py-1 opacity-60">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</a>
